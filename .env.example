# Copy the lines you need into your environment (or a process manager).
# Nothing here is required for local use - defaults are safe for 127.0.0.1.

# Where the database, encrypted files, keys and audit anchors live.
# TRUSTVAULT_INSTANCE_DIR=C:\TrustVault\instance

# In production, inject keys from a secret manager instead of key files.
# Generate one with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# TRUSTVAULT_MASTER_KEY=
# TRUSTVAULT_AUDIT_KEY=

# Turn on whenever the site is served over HTTPS (adds Secure cookie, __Host- prefix, HSTS).
# TRUSTVAULT_COOKIE_SECURE=1

# Only when running behind a reverse proxy you control (otherwise clients could fake their IP).
# TRUSTVAULT_TRUST_PROXY=1

# Time limits (defaults are defined once, in trustvault/config.py).
# TRUSTVAULT_LINK_TTL_SECONDS=300         # a share link works for 5 minutes
# TRUSTVAULT_DEFAULT_GRANT_MINUTES=30     # a grant without a chosen duration lasts 30 minutes
# TRUSTVAULT_SESSION_IDLE_MINUTES=15      # sign-out after 15 minutes without a request
# TRUSTVAULT_SESSION_MAX_HOURS=8          # sign-out 8 hours after sign-in
# TRUSTVAULT_SESSION_WARNING_SECONDS=120  # the page warns this long before an idle sign-out
# TRUSTVAULT_MAX_GRANT_DAYS=366

# Word / Excel / PowerPoint shown as pages through LibreOffice: auto (if installed), off, or a path to soffice.exe
# TRUSTVAULT_OFFICE_RENDERER=auto

# TRUSTVAULT_MAX_UPLOAD_MB=10
# TRUSTVAULT_LOGIN_MAX_FAILURES=5
# TRUSTVAULT_LOCKOUT_MINUTES=15
# TRUSTVAULT_TRASH_RETENTION_DAYS=30
# TRUSTVAULT_ENABLE_API_DOCS=1

# Leave on. Only the test suite turns fsync off (TRUSTVAULT_DURABLE_WRITES=0) for speed.
# TRUSTVAULT_DURABLE_WRITES=1

# Largest audit CSV export (rows). A bigger selection is refused and the refusal logged.
# TRUSTVAULT_AUDIT_EXPORT_MAX_ROWS=100000

# Two-step sign-in (TOTP) is required for these roles (comma separated; empty = optional for everyone).
# TRUSTVAULT_TOTP_REQUIRED_ROLES=admin,owner
# Seconds allowed between a correct password and its 6-digit code.
# TRUSTVAULT_TWO_FACTOR_CHALLENGE_SECONDS=300
# Access review flags grants nobody has used for this many days.
# TRUSTVAULT_UNUSED_GRANT_DAYS=30

# Confidential documents: new access defaults to View only for this many minutes.
# TRUSTVAULT_CONFIDENTIAL_GRANT_MINUTES=60
# An unanswered request for access lapses after this many days.
# TRUSTVAULT_ACCESS_REQUEST_DAYS=14
# Open requests one person may have at a time (stops request spam).
# TRUSTVAULT_MAX_PENDING_REQUESTS=20
